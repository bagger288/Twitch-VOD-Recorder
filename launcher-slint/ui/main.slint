import { Button, ScrollView, CheckBox, ComboBox, Palette } from "std-widgets.slint";

export struct RecordingItem {
    id: string,
    date_str: string,
    parts_count: int,
    duration_str: string,
    size_str: string,
    has_chat: bool,
    has_emotes: bool,
}

export struct ChannelItem {
    name: string,
    count: int,
}

export struct ImportPartItem {
    name: string,
    path: string,
    size_str: string,
}

component IconButton inherits Rectangle {
    in property <string> text;
    in property <bool> enabled: true;
    in property <color> bg_color: #26262c;
    in property <color> hover_color: #3b3b44;
    in property <color> text_color: #efeff1;
    callback clicked <=> touch.clicked;

    width: 24px;
    height: 22px;
    border-radius: 4px;
    background: !root.enabled ? #1d1d23 : (touch.has-hover ? root.hover_color : root.bg_color);
    animate background { duration: 120ms; }

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
    }

    Text {
        text: root.text;
        color: !root.enabled ? #4d4d5a : root.text_color;
        font-size: 9.5pt;
        font-weight: 700;
        vertical-alignment: center;
        horizontal-alignment: center;
    }
}

component AppInput inherits Rectangle {
    in-out property <string> text <=> input.text;
    in property <string> placeholder-text: "";
    in property <InputType> input-type: InputType.text;
    in property <bool> enabled: true;
    in property <bool> read-only: false;
    out property <bool> has-focus: input.has-focus;
    property <bool> show-password: false;

    forward-focus: input;
    height: 32px;
    background: input.has-focus ? #2d2d35 : #26262c;
    border-radius: 4px;
    border-width: 1px;
    border-color: input.has-focus ? #9146ff : #3b3b44;
    clip: true;

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 6px;

        input := TextInput {
            single-line: true;
            vertical-alignment: center;
            font-size: 10pt;
            color: #efeff1;
            selection-background-color: #9146ff;
            selection-foreground-color: #ffffff;
            input-type: (root.input-type == InputType.password && !root.show-password) ? InputType.password : InputType.text;
            enabled: root.enabled;
            read-only: root.read-only;
        }

        if root.input-type == InputType.password && root.text != "": TouchArea {
            width: 24px;
            mouse-cursor: pointer;
            clicked => { root.show-password = !root.show-password; }
            Text {
                text: root.show-password ? "👁" : "🔒";
                font-size: 10pt;
                vertical-alignment: center;
                horizontal-alignment: center;
            }
        }
    }

    if root.text == "" && !input.has-focus: Text {
        x: 10px;
        y: (parent.height - self.height) / 2;
        text: root.placeholder-text;
        font-size: 10pt;
        color: #71717a;
    }
}

component DialogButton inherits Rectangle {
    in property <string> text;
    in property <color> bg_color: #2d2d35;
    in property <color> hover_color: #3b3b44;
    in property <color> text_color: #ffffff;
    callback clicked <=> touch.clicked;

    height: 32px;
    background: touch.has-hover ? root.hover_color : root.bg_color;
    border-radius: 4px;
    animate background { duration: 150ms; }

    touch := TouchArea {
        mouse-cursor: pointer;
    }

    Text {
        text: root.text;
        color: root.text_color;
        font-size: 9pt;
        font-weight: 600;
        vertical-alignment: center;
        horizontal-alignment: center;
    }
}

component StatusPill inherits Rectangle {
    in property <bool> active: false;
    width: 34px;
    height: 20px;
    border-radius: 10px;
    background: root.active ? #133323 : #222229;
    border-width: 1px;
    border-color: root.active ? #1f573b : #30303a;

    Text {
        text: root.active ? "✓" : "—";
        color: root.active ? #00e676 : #686876;
        font-size: 8.5pt;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

component LogConsole inherits Rectangle {
    in property <string> title: "Лог выполнения";
    in property <string> text: "";
    callback clear_clicked();
    callback copy_clicked();

    background: #141417;
    border-radius: 6px;
    border-width: 1px;
    border-color: #262630;
    clip: true;

    VerticalLayout {
        spacing: 0px;

        // Console header bar
        Rectangle {
            height: 26px;
            background: #1b1b22;

            HorizontalLayout {
                padding-left: 10px;
                padding-right: 6px;
                spacing: 6px;

                Text {
                    text: root.title;
                    color: #9a9aa6;
                    font-size: 8.5pt;
                    font-weight: 600;
                    vertical-alignment: center;
                }

                Rectangle { horizontal-stretch: 1; }

                IconButton {
                    width: 78px;
                    height: 20px;
                    y: 3px;
                    text: "Копировать";
                    enabled: root.text != "";
                    bg_color: #25252e;
                    hover_color: #353542;
                    text_color: #d4d4dc;
                    clicked => { root.copy_clicked(); }
                }

                IconButton {
                    width: 66px;
                    height: 20px;
                    y: 3px;
                    text: "Очистить";
                    enabled: root.text != "";
                    bg_color: #25252e;
                    hover_color: #353542;
                    text_color: #d4d4dc;
                    clicked => { root.clear_clicked(); }
                }
            }

            Rectangle {
                y: parent.height - 1px;
                height: 1px;
                background: #262630;
            }
        }

        ScrollView {
            VerticalLayout {
                padding: 8px;
                Text {
                    text: root.text != "" ? root.text : "Ожидание событий…";
                    color: root.text != "" ? #efeff1 : #5e5e6b;
                    font-family: "Consolas";
                    font-size: 8.5pt;
                }
            }
        }
    }
}

export component MainWindow inherits Window {
    title: "Twitch recorder";
    icon: @image-url("assets/app.png");
    min-width: 560px;
    min-height: 640px;
    preferred-width: 680px;
    preferred-height: 780px;
    background: #18181b;

    // Palette
    out property <color> c_bg: #18181b;
    out property <color> c_card: #1f1f23;
    out property <color> c_input: #26262c;
    out property <color> c_accent: #9146ff;
    out property <color> c_accent_hover: #772ce8;
    out property <color> c_text: #efeff1;
    out property <color> c_text_dim: #adadb8;
    out property <color> c_title: #bf94ff;
    out property <color> c_btn_bg: #2d2d35;
    out property <color> c_btn_hover: #3b3b44;

    // State properties
    in-out property <int> active_tab: 0;

    init => {
        Palette.color-scheme = ColorScheme.dark;
    }

    // Callbacks
    // Close confirmation dialog
    in-out property <bool> show_close_dialog: false;
    callback confirm_quit();
    callback confirm_minimize_to_tray();
    callback cancel_close();

    callback select_tab(int);
    callback refresh_records();
    callback open_records_folder();
    callback open_session_folder();
    callback download_missing_emotes();
    callback launch_mpv();
    callback select_channel(string);
    callback select_recording(string);

    callback run_import();
    callback browse_import_video();
    callback add_import_parts();
    callback remove_import_part(int);
    callback move_import_part_up(int);
    callback move_import_part_down(int);
    callback sort_import_parts();
    callback clear_import_parts();
    callback clear_import_console();

    callback toggle_recording();
    callback clear_recorder_console();
    callback toggle_pc_agent();
    callback clear_pc_agent_console();
    callback copy_console_text(string);

    callback refresh_token_manually();
    callback save_settings();
    callback check_tool_paths();

    // Data models
    in property <[ChannelItem]> channels: [];
    in-out property <string> selected_channel: "";
    in property <[RecordingItem]> recordings: [];
    in-out property <string> selected_recording_id: "";
    in-out property <bool> emotes_busy: false;

    // Tab 2 Import properties
    in property <[ImportPartItem]> imp_parts: [];
    in property <string> imp_parts_summary: "Частей не добавлено";
    in-out property <string> imp_channel: "";
    in-out property <string> imp_video: "";
    in-out property <string> imp_time: "";
    in-out property <bool> imp_auto_detect: true;
    in-out property <string> imp_dates: "";
    in property <string> imp_console_text: "";
    in property <bool> imp_busy: false;

    // Tab 3 Live Recorder properties
    in-out property <string> rec_channel: "";
    in-out property <string> rec_quality: "best";
    in property <bool> rec_active: false;
    in property <string> rec_status_text: "Готов к записи";
    in property <string> rec_console_text: "";
    in property <string> rec_duration_text: "00:00:00";
    in property <string> rec_size_text: "0 MB";
    in property <string> rec_messages_text: "0 сообщ.";

    // Tab 4 PC Agent properties
    in property <bool> agent_active: false;
    in property <string> agent_status_text: "Листенер остановлен";
    in property <string> agent_console_text: "";
    in property <bool> agent_recording_now: false;
    in property <string> agent_duration_text: "00:00:00";
    in property <string> agent_size_text: "0 MB";
    in property <string> agent_messages_text: "0 сообщ.";

    // Tab 5 Settings properties
    in-out property <string> cfg_streamlink: "streamlink";
    in-out property <string> cfg_mpv: "mpv";
    in-out property <string> cfg_client_id: "";
    in-out property <string> cfg_app_token: "";
    in-out property <string> cfg_client_secret: "";
    in-out property <string> cfg_refresh_token: "";
    in property <string> cfg_token_status: "Токен обновляется при запуске";
    in-out property <string> cfg_records_dir: "records";
    in-out property <string> cfg_server_url: "";
    in-out property <string> cfg_proxy_playlist: "";
    in-out property <string> cfg_engine: "Auto";
    in property <string> status_streamlink: "";
    in property <bool> valid_streamlink: false;
    in property <string> status_mpv: "";
    in property <bool> valid_mpv: false;
    in property <string> status_ffmpeg: "";
    in property <bool> valid_ffmpeg: false;

    VerticalLayout {
        padding: 12px;
        spacing: 8px;

        // Header bar
        VerticalLayout {
            spacing: 2px;
            Text {
                text: "Twitch recorder";
                font-size: 14pt;
                font-weight: 700;
                color: root.c_title;
            }
            Text {
                text: "Запись стримов и чата";
                font-size: 9pt;
                color: root.c_text_dim;
            }
        }

        // Tab Navigation Buttons with Live Process Indicators
        HorizontalLayout {
            spacing: 4px;
            height: 34px;

            for tab_title[i] in ["Записи", "Импорт", "Запись", "PC Agent", "Настройки"]: Rectangle {
                background: root.active_tab == i ? root.c_accent : (tab_touch.has-hover ? #282830 : root.c_card);
                border-radius: 5px;
                border-width: root.active_tab == i ? 0px : 1px;
                border-color: #2a2a33;
                animate background { duration: 120ms; }

                tab_touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        root.active_tab = i;
                        root.select_tab(i);
                    }
                }

                HorizontalLayout {
                    alignment: center;
                    spacing: 6px;

                    if (i == 1 && root.imp_busy) || (i == 2 && root.rec_active) || (i == 3 && root.agent_active): Rectangle {
                        width: 8px;
                        height: 8px;
                        y: (parent.height - self.height) / 2;
                        border-radius: 4px;
                        background: i == 1 ? #ffb300 : (i == 2 ? #ff4b4b : (root.agent_recording_now ? #ff4b4b : #00e676));
                    }

                    Text {
                        text: tab_title;
                        color: root.active_tab == i ? #ffffff : root.c_text;
                        font-size: 10pt;
                        font-weight: root.active_tab == i ? 700 : 500;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
        }

        // Tab Content Area
        Rectangle {
            background: root.c_card;
            border-radius: 6px;
            clip: true;

            // Tab 1: Records
            if root.active_tab == 0: VerticalLayout {
                padding: 10px;
                spacing: 8px;

                if root.channels.length == 0: Rectangle {
                    background: #19191e;
                    border-radius: 6px;
                    border-width: 1px;
                    border-color: #2b2b34;
                    vertical-stretch: 1;

                    VerticalLayout {
                        alignment: center;
                        spacing: 10px;
                        padding: 24px;

                        Text {
                            text: "Сохранённых записей пока нет";
                            font-size: 12pt;
                            font-weight: 700;
                            color: #ffffff;
                            horizontal-alignment: center;
                        }

                        Text {
                            text: "Запустите запись прямого эфира во вкладке «Запись» или импортируйте видеофайл с историей чата во вкладке «Импорт».";
                            font-size: 9.5pt;
                            color: root.c_text_dim;
                            horizontal-alignment: center;
                            wrap: word-wrap;
                        }

                        HorizontalLayout {
                            alignment: center;
                            spacing: 10px;
                            padding-top: 6px;

                            Button {
                                text: "🔴 Перейти к записи";
                                primary: true;
                                clicked => {
                                    root.active_tab = 2;
                                    root.select_tab(2);
                                }
                            }

                            Button {
                                text: "⚡ Импортировать видео";
                                clicked => {
                                    root.active_tab = 1;
                                    root.select_tab(1);
                                }
                            }

                            Button {
                                text: "Обновить";
                                clicked => { root.refresh_records(); }
                            }
                        }
                    }
                }

                if root.channels.length > 0: HorizontalLayout {
                    spacing: 8px;
                    vertical-stretch: 1;

                    // Left channel column
                    VerticalLayout {
                        width: 155px;
                        spacing: 4px;

                        Text {
                            text: "КАНАЛЫ";
                            font-size: 9pt;
                            font-weight: 700;
                            color: root.c_text_dim;
                        }

                        ScrollView {
                            VerticalLayout {
                                spacing: 3px;
                                for ch in root.channels: Rectangle {
                                    height: 30px;
                                    background: root.selected_channel == ch.name ? root.c_accent : (ch_touch.has-hover ? #30303a : root.c_input);
                                    border-radius: 4px;
                                    animate background { duration: 120ms; }
                                    ch_touch := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => {
                                            root.selected_channel = ch.name;
                                            root.select_channel(ch.name);
                                        }
                                    }
                                    HorizontalLayout {
                                        padding-left: 8px;
                                        padding-right: 6px;
                                        spacing: 4px;
                                        Text {
                                            text: ch.name;
                                            color: #ffffff;
                                            font-size: 9.5pt;
                                            font-weight: root.selected_channel == ch.name ? 700 : 500;
                                            vertical-alignment: center;
                                            overflow: elide;
                                            horizontal-stretch: 1;
                                        }
                                        Rectangle {
                                            width: 24px;
                                            height: 18px;
                                            y: (parent.height - self.height) / 2;
                                            border-radius: 9px;
                                            background: root.selected_channel == ch.name ? #6e2fd4 : #1d1d23;
                                            Text {
                                                text: ch.count;
                                                color: root.selected_channel == ch.name ? #ffffff : root.c_text_dim;
                                                font-size: 8pt;
                                                font-weight: 700;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }

                    // Right table view
                    VerticalLayout {
                        spacing: 6px;
                        horizontal-stretch: 1;

                        // Toolbar
                        HorizontalLayout {
                            height: 28px;
                            spacing: 6px;
                            Text {
                                text: root.selected_channel != "" ? "Записи канала: " + root.selected_channel : "Выберите канал";
                                font-size: 10pt;
                                font-weight: 700;
                                color: #ffffff;
                                vertical-alignment: center;
                            }
                            Rectangle { horizontal-stretch: 1; }
                            Button {
                                text: "Папка";
                                clicked => { root.open_records_folder(); }
                            }
                            Button {
                                text: "Обновить";
                                clicked => { root.refresh_records(); }
                            }
                        }

                        // Table Header
                        Rectangle {
                            height: 28px;
                            background: #2b2b33;
                            border-radius: 4px;
                            HorizontalLayout {
                                padding-left: 8px;
                                padding-right: 8px;
                                spacing: 6px;
                                Text { horizontal-stretch: 1; min-width: 135px; text: "Дата и время"; font-size: 9pt; font-weight: 700; color: #ffffff; vertical-alignment: center; }
                                Text { width: 46px; text: "Части"; font-size: 9pt; font-weight: 700; color: #ffffff; vertical-alignment: center; }
                                Text { width: 72px; text: "Время"; font-size: 9pt; font-weight: 700; color: #ffffff; vertical-alignment: center; }
                                Text { width: 72px; text: "Размер"; font-size: 9pt; font-weight: 700; color: #ffffff; vertical-alignment: center; }
                                Text { width: 44px; text: "Чат"; font-size: 9pt; font-weight: 700; color: #ffffff; horizontal-alignment: center; vertical-alignment: center; }
                                Text { width: 54px; text: "Эмоуты"; font-size: 9pt; font-weight: 700; color: #ffffff; horizontal-alignment: center; vertical-alignment: center; }
                            }
                        }

                        // Recordings List
                        ScrollView {
                            VerticalLayout {
                                spacing: 3px;
                                for rec in root.recordings: Rectangle {
                                    height: 34px;
                                    background: root.selected_recording_id == rec.id ? root.c_accent : (rec_touch.has-hover ? #30303a : root.c_input);
                                    border-radius: 4px;
                                    animate background { duration: 120ms; }
                                    rec_touch := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => {
                                            root.selected_recording_id = rec.id;
                                            root.select_recording(rec.id);
                                        }
                                        double-clicked => {
                                            root.selected_recording_id = rec.id;
                                            root.launch_mpv();
                                        }
                                    }
                                    HorizontalLayout {
                                        padding-left: 8px;
                                        padding-right: 8px;
                                        spacing: 6px;
                                        Text { horizontal-stretch: 1; min-width: 135px; text: rec.date_str; color: #ffffff; font-weight: root.selected_recording_id == rec.id ? 600 : 400; vertical-alignment: center; overflow: elide; }
                                        Text { width: 46px; text: rec.parts_count + " ч."; color: root.selected_recording_id == rec.id ? #efe8ff : root.c_text_dim; vertical-alignment: center; }
                                        Text { width: 72px; text: rec.duration_str; color: root.c_text; vertical-alignment: center; }
                                        Text { width: 72px; text: rec.size_str; color: root.selected_recording_id == rec.id ? #efe8ff : root.c_text_dim; vertical-alignment: center; }
                                        Rectangle {
                                            width: 44px;
                                            StatusPill {
                                                x: (parent.width - self.width) / 2;
                                                y: (parent.height - self.height) / 2;
                                                active: rec.has_chat;
                                            }
                                        }
                                        Rectangle {
                                            width: 54px;
                                            StatusPill {
                                                x: (parent.width - self.width) / 2;
                                                y: (parent.height - self.height) / 2;
                                                active: rec.has_emotes;
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                // Footer
                HorizontalLayout {
                    height: 36px;
                    spacing: 8px;
                    Text {
                        text: root.emotes_busy ? "Кэширование эмоутов сессии…" : "Двойной клик — запуск";
                        color: root.emotes_busy ? root.c_title : root.c_text_dim;
                        font-size: 8.5pt;
                        vertical-alignment: center;
                    }
                    Rectangle { horizontal-stretch: 1; }
                    Button {
                        text: root.emotes_busy ? "Загрузка…" : "⬇ Докачать эмоуты";
                        enabled: !root.emotes_busy && root.recordings.length > 0;
                        clicked => { root.download_missing_emotes(); }
                    }
                    Button {
                        text: "Папка сессии";
                        enabled: root.recordings.length > 0;
                        clicked => { root.open_session_folder(); }
                    }
                    Button {
                        text: "▶ Смотреть в mpv";
                        primary: true;
                        enabled: root.recordings.length > 0;
                        clicked => { root.launch_mpv(); }
                    }
                }
            }

            // Tab 2: Import
            if root.active_tab == 1: VerticalLayout {
                padding: 10px;
                spacing: 8px;

                Text { text: "Импорт чата для существующих видео"; font-size: 11pt; font-weight: 700; color: root.c_title; }
                Text { text: "Канал Twitch:"; font-size: 9pt; color: root.c_text_dim; }
                AppInput { text <=> root.imp_channel; }

                // Video parts section
                VerticalLayout {
                    spacing: 4px;

                    HorizontalLayout {
                        spacing: 8px;
                        Text {
                            text: "Файлы видео (части записи):";
                            font-size: 9pt;
                            color: root.c_text_dim;
                            vertical-alignment: center;
                        }
                        if root.imp_parts.length > 0: Text {
                            text: root.imp_parts_summary;
                            color: root.c_title;
                            font-size: 8.5pt;
                            font-weight: 600;
                            vertical-alignment: center;
                        }
                        Rectangle { horizontal-stretch: 1; }
                        Button {
                            text: "+ Добавить видео…";
                            horizontal-stretch: 0;
                            clicked => { root.add_import_parts(); }
                        }
                        if root.imp_parts.length > 0: Button {
                            text: "Очистить";
                            horizontal-stretch: 0;
                            clicked => { root.clear_import_parts(); }
                        }
                    }

                    // Parts container: 1 row when empty or 1 part, expands up to 5 rows, scrolls if > 5
                    Rectangle {
                        height: root.imp_parts.length == 0 ? 32px : (
                            root.imp_parts.length == 1 ? 32px : (
                            root.imp_parts.length == 2 ? 66px : (
                            root.imp_parts.length == 3 ? 100px : (
                            root.imp_parts.length == 4 ? 134px : 168px
                        ))));
                        background: root.c_card;
                        border-radius: 4px;
                        border-width: 1px;
                        border-color: #2e2e38;
                        clip: true;

                        if root.imp_parts.length == 0: Rectangle {
                            background: root.c_input;
                            border-radius: 4px;
                            TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.add_import_parts(); }
                            }
                            HorizontalLayout {
                                padding-left: 10px;
                                padding-right: 10px;
                                Text {
                                    text: "Выберите видеофайлы (нажмите «+ Добавить видео…» или кликните сюда)";
                                    color: #71717a;
                                    font-size: 9pt;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }
                            }
                        }

                        if root.imp_parts.length > 0: ScrollView {
                            VerticalLayout {
                                spacing: 2px;
                                for part[i] in root.imp_parts: Rectangle {
                                    height: 32px;
                                    background: #23232b;
                                    border-radius: 3px;
                                    border-width: 1px;
                                    border-color: #2d2d38;

                                    HorizontalLayout {
                                        padding-left: 8px;
                                        padding-right: 6px;
                                        spacing: 6px;

                                        // Number
                                        Text {
                                            text: "\{i + 1}.";
                                            color: root.c_accent;
                                            font-size: 9pt;
                                            font-weight: 700;
                                            width: 24px;
                                            vertical-alignment: center;
                                        }

                                        // Filename
                                        Text {
                                            text: part.name;
                                            color: root.c_text;
                                            font-size: 9pt;
                                            overflow: elide;
                                            horizontal-stretch: 1;
                                            vertical-alignment: center;
                                        }

                                        // File size
                                        Text {
                                            text: part.size_str;
                                            color: root.c_text_dim;
                                            font-size: 8.5pt;
                                            width: 65px;
                                            horizontal-alignment: right;
                                            vertical-alignment: center;
                                        }

                                        // Move up / move down / remove
                                        HorizontalLayout {
                                            spacing: 2px;
                                            IconButton {
                                                text: "▲";
                                                enabled: i > 0;
                                                clicked => { root.move_import_part_up(i); }
                                            }
                                            IconButton {
                                                text: "▼";
                                                enabled: i < root.imp_parts.length - 1;
                                                clicked => { root.move_import_part_down(i); }
                                            }
                                            IconButton {
                                                text: "x";
                                                text_color: #f87171;
                                                hover_color: #4a2428;
                                                clicked => { root.remove_import_part(i); }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                Text { text: "Старт (UTC): YYYY-MM-DD HH:MM:SS"; font-size: 9pt; color: root.c_text_dim; }
                AppInput { text <=> root.imp_time; }

                HorizontalLayout {
                    spacing: 8px;
                    height: 24px;
                    Rectangle {
                        width: 18px;
                        height: 18px;
                        border-width: 1.5px;
                        border-color: root.imp_auto_detect ? root.c_accent : root.c_text_dim;
                        border-radius: 3px;
                        background: root.imp_auto_detect ? root.c_accent : root.c_input;
                        y: 3px;

                        if root.imp_auto_detect: Text {
                            text: "✓";
                            color: #ffffff;
                            font-size: 10pt;
                            font-weight: 700;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }

                        TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.imp_auto_detect = !root.imp_auto_detect; }
                        }
                    }
                    Text {
                        text: "Автоопределение старта по сообщениям";
                        color: root.c_text;
                        font-size: 9.5pt;
                        vertical-alignment: center;
                        TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.imp_auto_detect = !root.imp_auto_detect; }
                        }
                    }
                    Rectangle { }
                }

                Text { text: "Даты архива (UTC): YYYY-MM-DD, …"; font-size: 9pt; color: root.c_text_dim; }
                AppInput { text <=> root.imp_dates; }

                HorizontalLayout {
                    Button {
                        text: "⚡ Создать сессию из архива";
                        primary: true;
                        enabled: !root.imp_busy && root.imp_parts.length > 0;
                        clicked => { root.run_import(); }
                    }
                    Rectangle { }
                }

                // Log console
                LogConsole {
                    vertical-stretch: 1;
                    title: "Лог импорта и кэширования";
                    text: root.imp_console_text;
                    clear_clicked => { root.clear_import_console(); }
                    copy_clicked => { root.copy_console_text(root.imp_console_text); }
                }
            }

            // Tab 3: Record
            if root.active_tab == 2: VerticalLayout {
                padding: 10px;
                spacing: 8px;

                Text { text: "Запись стрима и чата"; font-size: 11pt; font-weight: 700; color: root.c_title; }
                Text { text: "Канал Twitch:"; font-size: 9pt; color: root.c_text_dim; }
                AppInput { text <=> root.rec_channel; }

                Text { text: "Качество:"; font-size: 9pt; color: root.c_text_dim; }
                HorizontalLayout {
                    ComboBox {
                        width: 140px;
                        model: ["best", "1080p60", "720p60", "480p", "worst"];
                        current-value <=> root.rec_quality;
                    }
                    Rectangle { }
                }

                HorizontalLayout {
                    Button {
                        text: root.rec_active ? "⏹ Остановить запись" : "🔴 Начать запись";
                        primary: true;
                        clicked => { root.toggle_recording(); }
                    }
                    Rectangle { }
                }

                Text { text: root.rec_status_text; color: root.c_text_dim; font-size: 9.5pt; }

                if root.rec_active: Rectangle {
                    height: 38px;
                    background: #1c1f26;
                    border-radius: 4px;
                    border-width: 1px;
                    border-color: #2e3440;
                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        spacing: 16px;

                        HorizontalLayout {
                            spacing: 6px;
                            Text { text: "⏱ Время:"; color: root.c_text_dim; font-size: 9pt; vertical-alignment: center; }
                            Text { text: root.rec_duration_text; color: #ffffff; font-weight: 700; font-size: 9.5pt; vertical-alignment: center; }
                        }
                        HorizontalLayout {
                            spacing: 6px;
                            Text { text: "💾 Размер:"; color: root.c_text_dim; font-size: 9pt; vertical-alignment: center; }
                            Text { text: root.rec_size_text; color: #64b5f6; font-weight: 700; font-size: 9.5pt; vertical-alignment: center; }
                        }
                        HorizontalLayout {
                            spacing: 6px;
                            Text { text: "💬 Чат:"; color: root.c_text_dim; font-size: 9pt; vertical-alignment: center; }
                            Text { text: root.rec_messages_text; color: #81c784; font-weight: 700; font-size: 9.5pt; vertical-alignment: center; }
                        }
                        Rectangle { }
                    }
                }

                // Recorder console
                LogConsole {
                    vertical-stretch: 1;
                    title: "Лог записи эфира";
                    text: root.rec_console_text;
                    clear_clicked => { root.clear_recorder_console(); }
                    copy_clicked => { root.copy_console_text(root.rec_console_text); }
                }
            }

            // Tab 4: PC Agent
            if root.active_tab == 3: VerticalLayout {
                padding: 10px;
                spacing: 8px;

                Text { text: "Автоматическая запись (PC Agent)"; font-size: 11pt; font-weight: 700; color: root.c_title; }
                Text { text: "Подключается к серверу мониторинга и автоматически записывает стримы"; font-size: 9pt; color: root.c_text_dim; }

                HorizontalLayout {
                    spacing: 8px;
                    Button {
                        text: root.agent_active ? "⏹ Стоп" : "▶ Старт";
                        primary: true;
                        clicked => { root.toggle_pc_agent(); }
                    }
                    Button {
                        text: "Очистить";
                        clicked => { root.clear_pc_agent_console(); }
                    }
                    Rectangle { }
                }

                Text {
                    text: root.agent_status_text;
                    color: root.agent_active ? #00c853 : root.c_text_dim;
                    font-size: 9.5pt;
                    font-weight: 700;
                }

                if root.agent_recording_now: Rectangle {
                    height: 38px;
                    background: #1c1f26;
                    border-radius: 4px;
                    border-width: 1px;
                    border-color: #2e3440;
                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        spacing: 16px;

                        HorizontalLayout {
                            spacing: 6px;
                            Text { text: "⏱ Время:"; color: root.c_text_dim; font-size: 9pt; vertical-alignment: center; }
                            Text { text: root.agent_duration_text; color: #ffffff; font-weight: 700; font-size: 9.5pt; vertical-alignment: center; }
                        }
                        HorizontalLayout {
                            spacing: 6px;
                            Text { text: "💾 Размер:"; color: root.c_text_dim; font-size: 9pt; vertical-alignment: center; }
                            Text { text: root.agent_size_text; color: #64b5f6; font-weight: 700; font-size: 9.5pt; vertical-alignment: center; }
                        }
                        HorizontalLayout {
                            spacing: 6px;
                            Text { text: "💬 Чат:"; color: root.c_text_dim; font-size: 9pt; vertical-alignment: center; }
                            Text { text: root.agent_messages_text; color: #81c784; font-weight: 700; font-size: 9.5pt; vertical-alignment: center; }
                        }
                        Rectangle { }
                    }
                }

                // Console
                LogConsole {
                    vertical-stretch: 1;
                    title: "Лог PC Agent";
                    text: root.agent_console_text;
                    clear_clicked => { root.clear_pc_agent_console(); }
                    copy_clicked => { root.copy_console_text(root.agent_console_text); }
                }
            }

            // Tab 5: Settings
            if root.active_tab == 4: VerticalLayout {
                padding: 10px;
                spacing: 8px;

                ScrollView {
                    vertical-stretch: 1;
                    VerticalLayout {
                        spacing: 10px;
                        padding-right: 10px;

                        // Section Card 1: External Tools
                        Rectangle {
                            background: #18181b;
                            border-radius: 6px;
                            border-width: 1px;
                            border-color: #2c2c35;

                            VerticalLayout {
                                padding: 12px;
                                spacing: 6px;

                                HorizontalLayout {
                                    Text {
                                        text: "Внешние утилиты";
                                        font-size: 10.5pt;
                                        font-weight: 700;
                                        color: root.c_title;
                                        vertical-alignment: center;
                                    }
                                    Rectangle { horizontal-stretch: 1; }
                                    Button {
                                        text: "🔍 Проверить утилиты";
                                        clicked => { root.check_tool_paths(); }
                                    }
                                }

                                Text { text: "Путь к Streamlink:"; font-size: 9pt; color: root.c_text_dim; }
                                AppInput { text <=> root.cfg_streamlink; }
                                if root.status_streamlink != "": Text {
                                    text: root.status_streamlink;
                                    color: root.valid_streamlink ? #00e676 : #ff5252;
                                    font-size: 8.5pt;
                                    font-weight: 700;
                                }

                                Text { text: "Путь к mpv:"; font-size: 9pt; color: root.c_text_dim; }
                                AppInput { text <=> root.cfg_mpv; }
                                if root.status_mpv != "": Text {
                                    text: root.status_mpv;
                                    color: root.valid_mpv ? #00e676 : #ff5252;
                                    font-size: 8.5pt;
                                    font-weight: 700;
                                }

                                Text { text: "Статус FFmpeg (для экспорта клипов):"; font-size: 9pt; color: root.c_text_dim; }
                                if root.status_ffmpeg != "": Text {
                                    text: root.status_ffmpeg;
                                    color: root.valid_ffmpeg ? #00e676 : #ffb300;
                                    font-size: 8.5pt;
                                    font-weight: 700;
                                }
                            }
                        }

                        // Section Card 2: Twitch API OAuth
                        Rectangle {
                            background: #18181b;
                            border-radius: 6px;
                            border-width: 1px;
                            border-color: #2c2c35;

                            VerticalLayout {
                                padding: 12px;
                                spacing: 6px;

                                Text {
                                    text: "Авторизация Twitch API";
                                    font-size: 10.5pt;
                                    font-weight: 700;
                                    color: root.c_title;
                                }

                                Text { text: "Twitch Client ID:"; font-size: 9pt; color: root.c_text_dim; }
                                AppInput { text <=> root.cfg_client_id; }

                                Text { text: "Twitch App/User Token:"; font-size: 9pt; color: root.c_text_dim; }
                                AppInput { text <=> root.cfg_app_token; input-type: InputType.password; }

                                Text { text: "Twitch Client Secret:"; font-size: 9pt; color: root.c_text_dim; }
                                AppInput { text <=> root.cfg_client_secret; input-type: InputType.password; }

                                Text { text: "Twitch Refresh Token:"; font-size: 9pt; color: root.c_text_dim; }
                                AppInput { text <=> root.cfg_refresh_token; input-type: InputType.password; }

                                HorizontalLayout {
                                    spacing: 8px;
                                    padding-top: 4px;
                                    Button { text: "Обновить токен"; clicked => { root.refresh_token_manually(); } }
                                    Text { text: root.cfg_token_status; color: root.c_text_dim; vertical-alignment: center; overflow: elide; }
                                    Rectangle { }
                                }
                            }
                        }

                        // Section Card 3: Paths & Network
                        Rectangle {
                            background: #18181b;
                            border-radius: 6px;
                            border-width: 1px;
                            border-color: #2c2c35;

                            VerticalLayout {
                                padding: 12px;
                                spacing: 6px;

                                Text {
                                    text: "Сеть, папки и движок";
                                    font-size: 10.5pt;
                                    font-weight: 700;
                                    color: root.c_title;
                                }

                                Text { text: "Папка records:"; font-size: 9pt; color: root.c_text_dim; }
                                AppInput { text <=> root.cfg_records_dir; }

                                Text { text: "SERVER_URL (сервер мониторинга):"; font-size: 9pt; color: root.c_text_dim; }
                                AppInput { text <=> root.cfg_server_url; placeholder-text: "https://your-bot-server.com"; }

                                Text { text: "Twitch Proxy Playlist (--twitch-proxy-playlist):"; font-size: 9pt; color: root.c_text_dim; }
                                AppInput { text <=> root.cfg_proxy_playlist; placeholder-text: "прокси через запятую"; }

                                HorizontalLayout {
                                    spacing: 8px;
                                    padding-top: 4px;
                                    Text { text: "Движок чата: Rust (twitch_chat.dll)"; color: #a3be8c; font-weight: 700; font-size: 9pt; vertical-alignment: center; }
                                    Rectangle { }
                                }
                            }
                        }
                    }
                }

                // Pinned bottom save bar
                Rectangle {
                    height: 42px;
                    background: #19191e;
                    border-radius: 6px;
                    border-width: 1px;
                    border-color: #2c2c35;

                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 10px;
                        spacing: 8px;

                        Text {
                            text: "Настройки сохраняются в config.json";
                            color: root.c_text_dim;
                            font-size: 8.5pt;
                            vertical-alignment: center;
                        }
                        Rectangle { horizontal-stretch: 1; }
                        Button {
                            text: "Сохранить настройки";
                            primary: true;
                            clicked => { root.save_settings(); }
                        }
                    }
                }
            }
        }
    }

    // Modal Close Confirmation Dialog
    if root.show_close_dialog: Rectangle {
        background: #000000b0;

        TouchArea {
            clicked => { root.cancel_close(); }
        }

        Rectangle {
            width: 280px;
            height: 192px;
            background: #1f1f23;
            border-radius: 8px;
            border-width: 1px;
            border-color: #3b3b44;

            TouchArea { }

            card_layout := VerticalLayout {
                padding-top: 14px;
                padding-bottom: 14px;
                padding-left: 16px;
                padding-right: 16px;
                spacing: 6px;

                Text {
                    text: "Закрытие лаунчера";
                    font-size: 11pt;
                    font-weight: 700;
                    color: #ffffff;
                    horizontal-alignment: center;
                }

                Text {
                    text: "Что сделать с приложением?";
                    font-size: 9pt;
                    color: root.c_text_dim;
                    horizontal-alignment: center;
                }

                Rectangle { height: 2px; }

                DialogButton {
                    text: "Выйти";
                    bg_color: #9F2305;
                    hover_color: #ba2a07;
                    clicked => { root.confirm_quit(); }
                }

                DialogButton {
                    text: "Свернуть в трей";
                    bg_color: #9146ff;
                    hover_color: #772ce8;
                    clicked => { root.confirm_minimize_to_tray(); }
                }

                DialogButton {
                    text: "Отмена";
                    bg_color: #2d2d35;
                    hover_color: #3b3b44;
                    clicked => { root.cancel_close(); }
                }
            }
        }
    }
}

export component LauncherTray inherits SystemTrayIcon {
    in-out property <string> tray_tooltip: "Twitch recorder";
    in-out property <string> status_text: "Готов к работе";

    icon: @image-url("assets/app.png");
    tooltip: root.tray_tooltip;

    clicked => {
        root.toggle_window();
    }

    Menu {
        MenuItem {
            title: "Показать / Скрыть окно";
            activated => { root.toggle_window(); }
        }
        MenuItem {
            title: root.status_text;
            enabled: false;
        }
        MenuItem {
            title: "Выход";
            activated => { root.quit_app(); }
        }
    }

    callback toggle_window();
    callback quit_app();
}
